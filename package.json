{
  "name": "anki-book",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "add": "tsx --env-file-if-exists=.env src/cli/add.ts",
    "rebuild": "tsx src/cli/rebuild.ts",
    "review": "tsx src/cli/review.ts",
    "generate": "tsx --env-file=.env src/cli/generate.ts",
    "export": "tsx src/cli/export.ts",
    "clean": "tsx src/cli/clean.ts",
    "ingest": "tsx --env-file-if-exists=.env src/cli/ingest.ts",
    "tokens": "tsx src/cli/tokens.ts",
    "typecheck": "tsc",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "server": "tsx --env-file-if-exists=.env src/server/index.ts",
    "server:watch": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:server:watch\" \"npm:web\"",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.3",
    "officeparser": "^7.6.1",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "private": true
}
